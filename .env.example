# ── Supabase (Project Settings > API) ───────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── 사이트 ─────────────────────────────────────────────────────────
# 관리자 화면 주소: https://<도메인>/<ADMIN_PATH>
ADMIN_PATH=adm
NEXT_PUBLIC_SITE_URL=https://sogang-cbe.vercel.app

# ── Cloudflare R2 ──────────────────────────────────────────────────
# 공개 파일(첨부·이미지·교수 사진)이 올라가는 주소. 끝에 / 없이.
NEXT_PUBLIC_MEDIA_BASE=https://pub-xxxxxxxx.r2.dev
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_MEDIA_BUCKET=sogang-cbe-media
R2_BACKUP_BUCKET=sogang-cbe-backup

# ── 번역 ───────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY를 비워 두면 무료 번역기를 쓴다. 키를 넣으면 코드 수정 없이 Claude 번역으로 바뀐다.
ANTHROPIC_API_KEY=
TRANSLATE_CONTACT_EMAIL=chemeng.sogang@gmail.com

# ── 알림 메일 (선택) ───────────────────────────────────────────────
# resend.com 무료 계정. 없으면 예약 신청은 정상 접수되고 메일만 생략된다.
RESEND_API_KEY=
NOTIFY_FROM=Sogang CBE <onboarding@resend.dev>
